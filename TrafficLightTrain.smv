---------------------------------------------------------------- 	      ----------------------------------------------------------------
---------------------------------------------------------------- TRAIN SIGNAL ----------------------------------------------------------------
----------------------------------------------------------------	      ----------------------------------------------------------------

MODULE TrainSignal(light_state, barrier_state, em_state, reset_state)
VAR
  train        : {absent, approaching, passing};
  pass_counter : 0..12;

ASSIGN
  init(train) := absent;
  init(pass_counter) := 0;

  next(train) :=
    case
      reset_state = on : absent; -- refresh/reset to system resets to when train isn't near
      em_state = on : absent;  -- emergency mode freezes train as absent

      train = absent & barrier_state = up : {absent, approaching};
      train = absent & barrier_state != up : absent;
      train = approaching & barrier_state = down : passing;
      train = passing & pass_counter = 12 : absent;
      TRUE : train;
    esac;

  next(pass_counter) :=
    case
      em_state = on : 0;  -- freeze counter
      train = passing & pass_counter < 12 : pass_counter + 1;
      train = absent : 0;
      TRUE : pass_counter;
    esac;


---------------------------------------------------------------- 	    ----------------------------------------------------------------
---------------------------------------------------------------- ROAD LIGHT ----------------------------------------------------------------
----------------------------------------------------------------	    ----------------------------------------------------------------

MODULE RoadLight(train_state, barrier_state, em_state, reset_state)
VAR
  road_light   : {green, yellow, red};
  light_counter: 0..7;

ASSIGN
  init(road_light) := green;
  init(light_counter) := 0;

  next(light_counter) :=
    case
      em_state = on : 0;  -- freeze counter
      road_light = yellow | road_light = red :
         (light_counter < 7 ? light_counter + 1 : light_counter);
      TRUE : 0;
    esac;

  next(road_light) :=
    case
      reset_state = on : green; -- refresh system sets light to green
      em_state = on : red;  -- emergency mode fixes light to red

      train_state = approaching : (light_counter < 2 ? yellow : red);
      train_state = passing : red;
      barrier_state = raising : red;
      barrier_state = up : green;
      TRUE : road_light;
    esac;


---------------------------------------------------------------- 	   ----------------------------------------------------------------
----------------------------------------------------------------  BARRIER  ----------------------------------------------------------------
----------------------------------------------------------------	   ----------------------------------------------------------------

MODULE Barrier(light_counter, train_state, em_state, reset_state)
VAR
  barrier        : {up, lowering, down, raising};
  barrier_counter: 0..10;

ASSIGN
  init(barrier) := up;
  init(barrier_counter) := 0;

  next(barrier) :=
    case
      reset_state = on : up; -- refresh to system sets the barrier to be up
      em_state = on : down;  -- emergency mode fixes barrier down

      barrier = up & light_counter = 7 : lowering;
      barrier = lowering & barrier_counter = 10 : down;
      barrier = down & train_state = absent : raising;
      barrier = raising & barrier_counter = 10 : up;
      TRUE : barrier;
    esac;

  next(barrier_counter) :=
    case
      em_state = on : 0;  -- freeze counter
      (barrier = lowering | barrier = raising) & barrier_counter < 10 :
         barrier_counter + 1;
      barrier = up | barrier = down : 0;
      TRUE : barrier_counter;
    esac;

---------------------------------------------------------------- 	    ----------------------------------------------------------------
---------------------------------------------------------------- EMERGENCY  ----------------------------------------------------------------
----------------------------------------------------------------	    ----------------------------------------------------------------

MODULE emergency(emergency_trigger)
VAR
    em_state : {off, on};

ASSIGN
    init(em_state) := off;

    next(em_state) :=
        case
            emergency_trigger : on;
            TRUE : em_state;  -- stays in emergency once triggered
        esac;


----------------------------------------------------------------       ----------------------------------------------------------------
---------------------------------------------------------------- RESET ----------------------------------------------------------------
----------------------------------------------------------------       ----------------------------------------------------------------
MODULE Reset(reset_trigger)
VAR
  reset_state : {off, on};  -- off = normal, on = reset

ASSIGN
  init(reset_state) := off;

  next(reset_state) :=
    case
      reset_trigger : on;   -- when trigger is true, go to reset
      TRUE          : off;
    esac;

---------------------------------------------------------------- 	     ----------------------------------------------------------------
---------------------------------------------------------------- MAIN MODULE ----------------------------------------------------------------
----------------------------------------------------------------	     ----------------------------------------------------------------
MODULE main

DEFINE
  -- Define the EFFECTIVE reset trigger: 
  -- It is TRUE only if the base 'reset_trigger' input is TRUE AND emergency is FALSE.
  -- so that in the case there is an emergency and someone tries to reset the system: it defaults to emergency and not reset
  reset_trigger_effective := reset_trigger & !emergency_trigger;

VAR
  emergency_trigger : boolean;  -- single emergency trigger
  reset_trigger     : boolean;  -- new module trigger

  emergency : process emergency(emergency_trigger);
  reset     : process Reset(reset_trigger_effective); -- Use the effective trigger here

  -- All subsequent modules use both the raw em_state and the effective reset_state and communicate with one another
  light   : process RoadLight(train.train, barrier.barrier, emergency.em_state, reset.reset_state);
  train   : process TrainSignal(light.road_light, barrier.barrier, emergency.em_state, reset.reset_state);
  barrier : process Barrier(light.light_counter, train.train, emergency.em_state, reset.reset_state);

ASSIGN
  -- Non-deterministic assignments for init() and next()
  -- The variables can be TRUE or FALSE freely in any state/next state
  -- The constraint below will enforce the mutual exclusion logic.

  init(emergency_trigger) := FALSE;
  next(emergency_trigger) := {FALSE, TRUE};

  init(reset_trigger) := FALSE;
  next(reset_trigger) := {FALSE, TRUE};

--SPEC_VARS
