MODULE main
VAR
  light   : RoadLight(train.train, barrier.barrier);
  train   : TrainSignal(light.road_light, barrier.barrier);
  barrier : Barrier(light.light_counter, train.train);

------------------------------------------------------------

MODULE TrainSignal(light_state, barrier_state)
VAR
  train        : {absent, approaching, passing};
  pass_counter : 0..12;

ASSIGN
  init(train) := absent;
  init(pass_counter) := 0;

  next(train) :=
    case
      --------------------------------------------------
      -- Train only appears when barrier is UP
      --------------------------------------------------
      train = absent & barrier_state = up :
         {absent, approaching};

      train = absent & barrier_state != up : absent;

      --------------------------------------------------
      -- Train goes from approaching -> passing
      --------------------------------------------------
      train = approaching & barrier_state = down : passing;

      --------------------------------------------------
      -- Passing ends after full counter
      --------------------------------------------------
      train = passing & pass_counter = 12 : absent;

      TRUE : train;
    esac;

  next(pass_counter) :=
    case
      train = passing & pass_counter < 12 : pass_counter + 1;
      train = absent : 0;
      TRUE : pass_counter;
    esac;

------------------------------------------------------------

MODULE RoadLight(train_state, barrier_state)
VAR
  road_light   : {green, yellow, red};
  light_counter: 0..7;

ASSIGN
  init(road_light) := green;
  init(light_counter) := 0;

  ----------------------------------------------------------
  -- Light counter runs ONLY during yellow/red
  ----------------------------------------------------------
  next(light_counter) :=
    case
      road_light = yellow | road_light = red :
         (light_counter < 7 ? light_counter + 1 : light_counter);
      TRUE : 0;
    esac;

  ----------------------------------------------------------
  -- Light behavior
  ----------------------------------------------------------
  next(road_light) :=
    case
      --------------------------------------------------------
      -- When train appears → YELLOW → RED
      --------------------------------------------------------
      train_state = approaching :
        (light_counter < 2 ? yellow : red);

      --------------------------------------------------------
      -- Train is passing → RED
      --------------------------------------------------------
      train_state = passing : red;

      --------------------------------------------------------
      -- Train gone BUT barrier still raising → KEEP RED
      --------------------------------------------------------
      barrier_state = raising : red;

      --------------------------------------------------------
      -- Barrier fully UP → GREEN
      --------------------------------------------------------
      barrier_state = up : green;

      TRUE : road_light;
    esac;

------------------------------------------------------------

MODULE Barrier(light_counter, train_state)
VAR
  barrier        : {up, lowering, down, raising};
  barrier_counter: 0..10;

ASSIGN
  init(barrier) := up;
  init(barrier_counter) := 0;

  next(barrier) :=
    case
      --------------------------------------------------------
      -- Start lowering only when light has turned RED
      --------------------------------------------------------
      barrier = up & light_counter = 7 : lowering;

      --------------------------------------------------------
      -- Finish lowering after 10 ticks
      --------------------------------------------------------
      barrier = lowering & barrier_counter = 10 : down;

      --------------------------------------------------------
      -- Train gone → raise barrier
      --------------------------------------------------------
      barrier = down & train_state = absent : raising;

      --------------------------------------------------------
      -- Finish raising after 10 ticks → goes to UP
      --------------------------------------------------------
      barrier = raising & barrier_counter = 10 : up;

      TRUE : barrier;
    esac;

  next(barrier_counter) :=
    case
      (barrier = lowering | barrier = raising) & barrier_counter < 10 :
         barrier_counter + 1;

      barrier = up | barrier = down : 0;

      TRUE : barrier_counter;
    esac;









-- The light is red for 5 seconds(immediately when train is approachine) before that 2 second for yellow 
-- then the barrier lowers for 10 seconds, 
-- We can stay in the train passing state by looping back to it
-- 10 seconds to go up while the light still being red
-- Then fully up (after 10 seconds) -> green
