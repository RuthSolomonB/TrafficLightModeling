MODULE main
VAR
  trigger_reset : boolean;
  trigger_danger : boolean;

  emergency : emergency(trigger_reset, trigger_danger);

  light   : RoadLight(train.train, barrier.barrier, emergency.em_state);
  train   : TrainSignal(light.road_light, barrier.barrier, emergency.em_state);
  barrier : Barrier(light.light_counter, train.train, emergency.em_state);

----------------------------------------------------------------------------------------------------
-- Keep the triggers for emergency FALSE initially unless selected at a later state (nondeterministically?????)
----------------------------------------------------------------------------------------------------

ASSIGN
  init(trigger_reset) := FALSE;
  --next(trigger_reset) := trigger_reset;  -- stays the same unless you model a toggle -- ended up not working (fully removed the emergency states from being seen in any simulation steps)
  next(trigger_reset) := {FALSE, TRUE}; -- non deterministic -> has all the combinatin of the 2 emergency states

  init(trigger_danger) := FALSE;
  --next(trigger_danger) := trigger_danger;  -- stays the same -- ended up not working
  next(trigger_danger) := {FALSE, TRUE};


------------------------------------------------------------

MODULE TrainSignal(light_state, barrier_state, em_state)
VAR
  train        : {absent, approaching, passing};
  pass_counter : 0..12;

ASSIGN
  init(train) := absent;
  init(pass_counter) := 0;

  next(train) :=
    case

      em_state = reset_mode : absent;
      em_state = danger_mode : passing;  -- train is present in danger mode

      --------------------------------------------------
      -- Train only appears when barrier is UP
      --------------------------------------------------
      train = absent & barrier_state = up :
         {absent, approaching};

      train = absent & barrier_state != up : absent;

      --------------------------------------------------
      -- Train goes from approaching -> passing
      --------------------------------------------------
      train = approaching & barrier_state = down : passing;

      --------------------------------------------------
      -- Passing ends after full counter
      --------------------------------------------------
      train = passing & pass_counter = 12 : absent;

      TRUE : train;
    esac;

  next(pass_counter) :=
    case
      em_state = danger_mode : 0;
      train = passing & pass_counter < 12 : pass_counter + 1;
      train = absent : 0;
      TRUE : pass_counter;
    esac;

------------------------------------------------------------

MODULE RoadLight(train_state, barrier_state, em_state)
VAR
  road_light   : {green, yellow, red};
  light_counter: 0..7;

ASSIGN
  init(road_light) := green;
  init(light_counter) := 0;

  ----------------------------------------------------------
  -- Light counter runs ONLY during yellow/red
  ----------------------------------------------------------
  next(light_counter) :=
    case
      em_state = reset_mode | em_state = danger_mode : 0;
      road_light = yellow | road_light = red :
         (light_counter < 7 ? light_counter + 1 : light_counter);
      TRUE : 0;
    esac;

  ----------------------------------------------------------
  -- Light behavior
  ----------------------------------------------------------
  next(road_light) :=
    case

      em_state = reset_mode : green;
      em_state = danger_mode : red;  


      --------------------------------------------------------
      -- When train appears → YELLOW → RED
      --------------------------------------------------------
      train_state = approaching :
        (light_counter < 2 ? yellow : red);

      --------------------------------------------------------
      -- Train is passing → RED
      --------------------------------------------------------
      train_state = passing : red;

      --------------------------------------------------------
      -- Train gone BUT barrier still raising → KEEP RED
      --------------------------------------------------------
      barrier_state = raising : red;

      --------------------------------------------------------
      -- Barrier fully UP → GREEN
      --------------------------------------------------------
      barrier_state = up : green;

      TRUE : road_light;
    esac;

------------------------------------------------------------

MODULE Barrier(light_counter, train_state, em_state)
VAR
  barrier        : {up, lowering, down, raising};
  barrier_counter: 0..10;

ASSIGN
  init(barrier) := up;
  init(barrier_counter) := 0;

  next(barrier) :=
    case

      em_state = reset_mode : up;
      em_state = danger_mode : down;  

      --------------------------------------------------------
      -- Start lowering only when light has turned RED
      --------------------------------------------------------
      barrier = up & light_counter = 7 : lowering;

      --------------------------------------------------------
      -- Finish lowering after 10 ticks
      --------------------------------------------------------
      barrier = lowering & barrier_counter = 10 : down;

      --------------------------------------------------------
      -- Train gone → raise barrier
      --------------------------------------------------------
      barrier = down & train_state = absent : raising;

      --------------------------------------------------------
      -- Finish raising after 10 ticks → goes to UP
      --------------------------------------------------------
      barrier = raising & barrier_counter = 10 : up;

      TRUE : barrier;
    esac;

  next(barrier_counter) :=
    case
      (barrier = lowering | barrier = raising) & barrier_counter < 10 :
         barrier_counter + 1;

      barrier = up | barrier = down : 0;

      TRUE : barrier_counter;
    esac;



MODULE emergency(trigger_reset, trigger_danger)
    VAR
        em_state : {none, reset_mode, danger_mode};

    ASSIGN
        init(em_state) := none;

        next(em_state) :=
            case
                -- Emergency activated at any time
                trigger_reset : reset_mode;
                trigger_danger : danger_mode;

                -- If not triggering, stay in same mode
                TRUE : em_state;
            esac;





-- The light is red for 5 seconds(immediately when train is approachine) before that 2 second for yellow 
-- then the barrier lowers for 10 seconds, 
-- We can stay in the train passing state by looping back to it
-- 10 seconds to go up while the light still being red
-- Then fully up (after 10 seconds) -> green
