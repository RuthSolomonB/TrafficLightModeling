--  barrier.barrier_counter,
--  train.train,
--  train.pass_counter,
--  emergency_trigger,
--  reset_trigger_effective;


  --light.road_light = green
  --light.light_counter = 0
  --train.train = absent
  --train.pass_counter = 0
  --barrier.barrier = up
  --barrier.barrier_counter = 0

---------------------------------------------------------------- 	      	      ----------------------------------------------------------------
---------------------------------------------------------------- SPECIFICATION CHECKS ----------------------------------------------------------------
----------------------------------------------------------------	      	      ----------------------------------------------------------------

------------------------ SAFETY REQUIREMENTS ------------------------
 
-- Train may only be passing when barrier is down (CO-1, FR-3)
SPEC AG (train.train = passing -> barrier.barrier = down) -- true sync, false async

-- Light must be red whenever barrier is not fully up (CO-2)
SPEC AG (barrier.barrier != up -> light.road_light = red) -- false sync, false async

-- Barrier must not start going up until train has completely passed (CO-3, FR-7)
SPEC AG (barrier.barrier = raising -> train.train = absent) -- true sync, true async

----------------------- DEADLOCK-FREE OPERATION ---------------------



----------------------- PROGRESS REQUIREMENTS -----------------------

-- Barrier must eventually go down if the train is approaching
SPEC AG (train.train = approaching -> AF (barrier.barrier = down)) -- false sync, false async

-- Barrier must eventually go up once the train has passed
SPEC AG (train.train = absent -> AF (barrier.barrier = up)) -- false sync, false async

-- Road light should eventually turn green again when it is safe
SPEC AG ((train.train = absent & barrier.barrier = up & emergency.em_state = off) -> AF (light.road_light = green)) -- true sync, false async

---------------------- ADDITIONAL SPECIFICATIONS --------------------

-- Whenever train is passing, light must be red 
SPEC AG (train.train = passing -> light.road_light = red) -- true sync, false async

